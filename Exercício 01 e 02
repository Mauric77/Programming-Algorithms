def valida_string(texto, minimo=1, maximo=100):
    """
    Valida se o comprimento de uma string está entre os limites fornecidos.
    """
    tamanho = len(texto)

    # Verifica se está no intervalo (inclusive)
    if minimo <= tamanho <= maximo:
        return True
    else:
        return False


